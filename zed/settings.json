// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_server_timeout": 10,
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": true
  },
  "context_servers": {
    "android-studio": {
      "enabled": true,
      "remote": false,
      "command": "/Users/felixb/Projects/Android-Studio-MCP-Claude-Code/.venv/bin/python",
      "args": [
        "-m",
        "android_studio_mcp"
      ],
      "env": {
        "ASMCP_WORKSPACE_ROOTS": "/Users/felixb/Projects"
      }
    },
    "cloudflare-api": {
      "enabled": true,
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "gpui-box": {
      "timeout": 10,
      "enabled": true,
      "url": "https://gpui-box.origingame.dev/mcp"
    },
    "nu-mcp-server": {
      "enabled": true,
      "remote": false,
      "command": "nu",
      "args": [
        "--mcp"
      ],
      "env": {
        "SHOW_CUSTOM_BANNER": "false"
      }
    }
  },
  "node": {
    "ignore_system_version": true,
  },
  "language_models": {
    "ollama": {
      "api_url": "https://ollama.felixb.dev",
    },
  },
  "cli_default_open_behavior": "new_window",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
    },
    "ollama": {
      "prompt_format": "infer",
      "api_url": "https://ollama.felixb.dev",
      "model": "qwen3:4b",
    },
    "provider": "zed",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "thinking_display": "preview",
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "single_file_review": false,
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "copilot_chat",
      "model": "claude-opus-5.5",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim_mode": true,
  "ui_font_size": 15.0,
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "Fleet Light",
    "dark": "Anysphere Dark",
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  // "active_pane_modifiers": {
  //   "inactive_opacity": 0.9
  // },
  "minimap": {
    "show": "auto",
  },
  "gutter": {
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "min_line_number_digits": 3,
  },
  "indent_guides": {
    "line_width": 1,
  },
  "tab_bar": {
    "show": false,
  },
  "terminal": {
    "dock": "right",
    "shell": "system",
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_family": "FiraCode Nerd Font",
  },
  "soft_wrap": "editor_width",
  "use_smartcase_search": true,
}
